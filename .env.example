# PostgreSQL connection string (Local EC2 Postgres, AWS RDS, Neon, or Supabase)
# Leave blank to run in zero-config Demo Mode with full in-memory seed data
DATABASE_URL="postgresql://aibo8:aibo8_strong_password@127.0.0.1:5432/aibo8_lms?schema=public"

# Secret key for signing JWT auth cookies (generate with: openssl rand -hex 32)
JWT_SECRET="aibo8-super-secret-jwt-key-change-in-production"

# Set to "true" once HTTPS/SSL (Certbot or AWS ALB) is enabled on your domain
COOKIE_SECURE="false"

# Optional: Payment Gateways (Phase 2)
# STRIPE_SECRET_KEY=""
# RAZORPAY_KEY_ID=""
# RAZORPAY_KEY_SECRET=""
